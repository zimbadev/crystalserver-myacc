{% if worlds is defined and worlds|length > 1 %}
  <div class="TableContainer" style="margin-bottom: 6px;">
    <table class="Table1" cellpadding="0" cellspacing="0">
      <tbody>
      <tr>
        <td>
          <div class="InnerTableContainer">
            <form action="" method="post" style="margin: 0;">
              <table style="width: 100%">
                <tbody>
                <tr>
                  <td style="vertical-align: middle;" class="LabelV150">World:</td>
                  <td>
                    <select name="world" onchange="this.form.submit()">
                      {% for w in worlds %}
                        <option value="{{ w.name }}"{% if world is defined and world and w.id == world.id %} selected="selected"{% endif %}>{{ w.name }}</option>
                      {% endfor %}
                    </select>
                  </td>
                </tr>
                </tbody>
              </table>
            </form>
          </div>
        </td>
      </tr>
      </tbody>
    </table>
  </div>
{% endif %}
